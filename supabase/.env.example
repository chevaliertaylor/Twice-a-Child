# Secrets for Supabase Edge Functions.
# Local: copy to supabase/.env and run `supabase functions serve --env-file supabase/.env`
# Deployed: `supabase secrets set ANTHROPIC_API_KEY=...`
#
# SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically by the platform
# (and by `supabase functions serve` locally) — do not set them here.

ANTHROPIC_API_KEY=sk-ant-...

# Shared secret the scheduler must send as the x-cron-secret header to invoke
# the checkin-cron function. Generate a long random value.
CRON_SECRET=replace-with-a-long-random-string

