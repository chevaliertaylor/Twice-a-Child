# App-side Supabase config. Copy to .env (gitignored) for local dev.
# These are public values (safe to ship in the client); RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# RevenueCat public SDK keys (billing). Leave unset to disable the paywall in
# development. Configure a "premium" entitlement and a $5.99/mo product with a
# 7-day intro trial in the RevenueCat dashboard.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
